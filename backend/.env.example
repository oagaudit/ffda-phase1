# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า

# ---------------------------------------------------------------------------
# โหมดการติดตั้ง:  dev | staff | public
#   dev    = เครื่องนักพัฒนา (Mac) สลับดูได้ทุกโหมด ผู้ใช้จำลอง
#   staff  = เครื่อง intranet ของ สตง. — IIS ยืนยันตัวตนด้วย Windows Authentication (SSO/AD) ไม่มีหน้า login
#   public = เครื่องที่เปิดสู่อินเทอร์เน็ต — มีเฉพาะโหมดภาพรวม/ประชาชน ไม่มี API ของเจ้าหน้าที่
FFDA_MODE=dev

# ฐานข้อมูลของเครื่องนี้
#   dev เริ่มเร็วด้วย SQLite:   sqlite:///./ffda.db
#   staff/public:               postgresql+psycopg://ffda:รหัสผ่าน@localhost:5432/ffda
DATABASE_URL=sqlite:///./ffda.db

# (เฉพาะเครื่อง staff) ฐานข้อมูลของเครื่อง public — ตั้งค่าแล้วเมื่อกด "เผยแพร่" ระบบจะส่งเฉพาะข้อมูลที่เผยแพร่ได้ไปให้
# ถ้าใช้เครื่องเดียวกันและฐานข้อมูลเดียวกัน ให้เว้นว่างไว้
PUBLIC_DATABASE_URL=

# ---------------------------------------------------------------------------
# SSO (เฉพาะ FFDA_MODE=staff)
# IIS ส่งชื่อผู้ใช้ AD มาใน header นี้ (ดู deploy/windows/staff/web.config)
TRUSTED_USER_HEADER=X-Remote-User
# รับ header จาก IIS บนเครื่องเดียวกันเท่านั้น
TRUSTED_PROXIES=127.0.0.1,::1
# ผู้ดูแลระบบเริ่มต้น (บัญชี AD คั่นด้วยจุลภาค) เช่น OAG\somchai.k,OAG\suda.p
ADMIN_USERS=

# (ทางเลือก) ตรวจกลุ่ม AD ผ่าน LDAP — ต้อง pip install ldap3
AD_LDAP_URL=
AD_BIND_USER=
AD_BIND_PASSWORD=
AD_BASE_DN=
# สมาชิกกลุ่มนี้ = ผู้ดูแลระบบ (นำเข้า/เผยแพร่/ตั้งค่า)
AD_ADMIN_GROUP=
# ถ้าตั้งไว้ เฉพาะสมาชิกกลุ่มนี้ที่เข้าระบบได้ (ไม่ตั้ง = ทุกคนในโดเมนที่ผ่าน IIS เข้าได้ในสิทธิ์เจ้าหน้าที่)
AD_USER_GROUP=

# (เฉพาะ dev) ผู้ใช้จำลองเมื่อเลือกโหมดเจ้าหน้าที่
DEV_USER=DEV\developer


# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
